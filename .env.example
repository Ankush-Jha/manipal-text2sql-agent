WRITER_URL=http://localhost:8081/v1
JUDGE_URL=http://localhost:8082/v1
DECIDER=local
TYPESAFE_API_KEY=
MODE=product
N_SAMPLES=5
TEMPERATURE=0.8
QUERY_TIMEOUT_S=10
MAX_ROWS=1000
DB_DIR=data/dev_databases
USE_BIRD_HINTS=false
# triage alone never refuses (measured 40% false refusals)
TRIAGE_REFUSE_P=1.01
# refuse when P(answerable) <= this ...
VETO_TRIAGE_MAX=0.15
# ... and the judge's P(yes) < this
VETO_JUDGE_MAX=0.5
# ask which measure when P(unclear) >= this
RULES_CLARIFY_P=0.5
# apply a business rule when P(that measure) >= this
RULES_APPLY_P=0.8
